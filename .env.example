# ==============================================================================
# Wispify Agent — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# `.env` is git-ignored and must NEVER be committed. Every value below is a
# placeholder — none of them are real credentials.
#
# Most integration credentials (Meta, Gemini, Google Calendar, Stripe) can
# ALSO be entered later through the admin panel's guided setup screen
# (Settings -> Integrations) instead of here. The variables below only act
# as an optional one-time seed read on first boot — useful for headless or
# Docker deployments. Once a credential is saved through the panel, the
# database value takes precedence over these env vars.
# ==============================================================================

# --- Server -------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# --- Admin account (required — used to log into the admin panel) --------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password

# --- Config encryption (optional) ----------------------------------------------
# AES-256-GCM key used to encrypt integration credentials at rest.
# If left unset, a key is auto-generated on first boot and stored at
# data/.keyfile (0600 permissions) — fine for a single-server deployment.
# Set this explicitly if you need reproducible deploys or multiple instances
# sharing the same encrypted data.
CONFIG_ENCRYPTION_KEY=

# --- Meta WhatsApp Cloud API (required for the bot to send/receive messages) --
# Get these from https://developers.facebook.com/apps -> your app -> WhatsApp.
# Can also be configured via the admin panel's guided setup instead.
META_ACCESS_TOKEN=your_meta_cloud_api_access_token_here
META_PHONE_NUMBER_ID=your_meta_phone_number_id_here
META_APP_SECRET=your_meta_app_secret_here
META_VERIFY_TOKEN=choose_any_random_string_and_paste_it_into_the_meta_webhook_form

# --- Google Gemini (required for the bot to generate AI replies) --------------
# Get an API key from https://aistudio.google.com/app/apikey
# Can also be configured via the admin panel's guided setup instead.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Google Calendar (optional — enables appointment booking) -----------------
# OAuth 2.0 client credentials from https://console.cloud.google.com/apis/credentials
# The refresh token itself is obtained through the admin panel's OAuth
# consent flow, not via env var.
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REDIRECT_URI=https://your-domain.example.com/api/settings/google-calendar/oauth/callback

# --- Stripe (optional — enables payment checkout) ------------------------------
# Get these from https://dashboard.stripe.com/apikeys and
# https://dashboard.stripe.com/webhooks
# Can also be configured via the admin panel's guided setup instead.
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret_here
